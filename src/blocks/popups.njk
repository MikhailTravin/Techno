<!--Спасибо-->
<div id="thanks" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div data-close class="popup__close">
                <img loading="lazy" src="img/icon/close.svg" alt="">
            </div>
            <div class="popup__body">
                <div class="popup__icon icon-check">
                    <img loading="lazy" src="img/icon/check3.svg" alt="">
                </div>
                <div class="popup__top">
                    <div class="popup__title">Спасибо!</div>
                    <p>
                        Ваша заявка отправлена. Мы свяжемся с вами в ближайшее время
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!--Не удалось отправить заявку-->
<div id="failed" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div data-close class="popup__close">
                <img loading="lazy" src="img/icon/close.svg" alt="">
            </div>
            <div class="popup__body">
                <div class="popup__icon">
                    <img loading="lazy" src="img/icon/close.svg" alt="">
                </div>
                <div class="popup__top">
                    <div class="popup__title">Не удалось отправить заявку</div>
                    <p>
                        Проверьте данные или попробуйте позже
                    </p>
                </div>
                <a href="./" class="btn btn-orange">
                    <span>Попробовать еще раз</span>
                    <img src="img/icon/arrow1.svg" alt="">
                </a>
            </div>
        </div>
    </div>
</div>

<!--Капча-->
<div id="captcha" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div data-close class="popup__close">
                <img loading="lazy" src="img/icon/close.svg" alt="">
            </div>
            <div class="popup__body">
                <div class="popup__icon">
                    <img loading="lazy" src="img/icon/check3.svg" alt="">
                </div>
                <div class="popup__top">
                    <div class="popup__title mini">Подтвердите что вы человек</div>
                </div>
                <div id="captcha-container" class="smart-captcha" data-sitekey="ВАШ_КЛЮЧ_КЛИЕНТА" data-hl="ru"></div>
            </div>
        </div>
    </div>
</div>